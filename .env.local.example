# ─── Strapi CMS ──────────────────────────────────────────────────────────────

# Server-only: used in RSC / server actions. Never prefix with NEXT_PUBLIC_.
STRAPI_URL=http://localhost:1337

# Client-accessible: needed to resolve media URLs in client components.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# API token generated in Strapi Admin → Settings → API Tokens.
# Use "Read-only" role for the frontend. Never commit this value.
STRAPI_API_TOKEN=your-strapi-api-token-here

# ─── Strapi Cloud (production) ───────────────────────────────────────────────
# Uncomment and fill in when deploying:
# STRAPI_URL=https://your-project.strapiapp.com
# NEXT_PUBLIC_STRAPI_URL=https://your-project.strapiapp.com
# STRAPI_API_TOKEN=your-production-token

# ─── Cache Revalidation ──────────────────────────────────────────────────────
# Secret token to secure the on-demand webhook revalidation endpoint.
# Generate a secure random string and configure the same token as a Bearer
# token header in the Strapi Webhook settings.
REVALIDATION_SECRET=your-revalidation-webhook-secret-here
